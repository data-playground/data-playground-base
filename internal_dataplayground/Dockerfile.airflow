# Dockerfile.airflow
# Extends the official Airflow image with:
#   - pymysql for MariaDB connectivity
#   - All Life OS Python dependencies needed by DAGs

FROM apache/airflow:2.9.1

# Switch to root to install system dependencies
USER root
RUN apt-get update && apt-get install -y \
    build-essential \
    libmariadb-dev \
    && rm -rf /var/lib/apt/lists/*

# Back to airflow user for pip installs
USER airflow

# Install pymysql + every library your DAGs import
# This mirrors your FastAPI requirements minus the web-only packages
RUN pip install --no-cache-dir \
    pymysql==1.1.0 \
    sqlalchemy==2.0.48 \
    asyncmy==0.2.11 \
    google-cloud-secret-manager==2.26.0 \
    google-auth==2.49.0 \
    httpx>=0.28.1 \
    requests==2.32.5 \
    pydantic==2.12.5 \
    python-dotenv==1.1.0 \
    google-genai==1.66.0