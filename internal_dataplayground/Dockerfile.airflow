# Dockerfile.airflow
FROM apache/airflow:2.10.4-python3.11

USER root
RUN apt-get update && apt-get install -y \
    build-essential \
    libmariadb-dev \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Only install packages that Airflow does NOT already bundle.
# Do NOT install sqlalchemy, httpx, requests, or typing-extensions —
# Airflow ships with its own pinned versions and overriding them breaks things.
RUN pip install --no-cache-dir \
    pymysql==1.1.0 \
    asyncmy==0.2.11 \
    google-cloud-secret-manager==2.26.0 \
    google-auth==2.49.0 \
    pydantic==2.12.5 \
    python-dotenv==1.1.0 \
	sqlalchemy>=2.0.0 \
    google-genai==1.66.0